  },
  "devDependencies": {
    "@eslint/js": "9.16.0",
    "eslint": "9.16.0",
    "eslint-plugin-react-hooks": "5.1.0",
    "globals": "15.13.0",
    "typescript": "catalog:",
    "typescript-eslint": "8.18.0"
  }
}
