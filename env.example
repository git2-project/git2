# Copy to .env and fill in. Real environment variables override this file.

# ── Server ────────────────────────────────────────────────────────────────────
SERVER_PORT=8080
ENVIRONMENT=dev                  # dev | prod

# ── PostgreSQL (Supabase, dev only) ───────────────────────────────────────────
# Supabase Dashboard → Connect → Connection string. The transaction pooler
# (port 6543) is detected and prepared statements are turned off for it.
POSTGRES_DSN=
POSTGRES_MAX_CONNS=10

# Optional: a throwaway database for the Postgres integration test in
# `make tests`. Leave empty to skip it. It creates and deletes its own rows.
TEST_POSTGRES_DSN=

# ── Redis ─────────────────────────────────────────────────────────────────────
# Host: localhost:6379 (make deps). The devcontainer overrides it to redis:6379.
REDIS_ADDR=localhost:6379
# Host port `make deps` publishes Redis on. Change both when 6379 is taken.
REDIS_PORT=6379
REDIS_PASSWORD=

# ── Auth ──────────────────────────────────────────────────────────────────────
# At least 32 characters: openssl rand -hex 32
JWT_SECRET=
JWT_EXPIRY=15m
REFRESH_TOKEN_EXPIRY=720h
