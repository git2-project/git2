# Copy to .env and fill in. Real environment variables override this file.

# ── Server ────────────────────────────────────────────────────────────────────
SERVER_PORT=8080
ENVIRONMENT=dev                  # dev | prod

# ── PostgreSQL (Supabase, dev only) ───────────────────────────────────────────
# Supabase Dashboard → Connect → Connection string. The transaction pooler
# (port 6543) is detected and prepared statements are turned off for it.
POSTGRES_DSN=
POSTGRES_MAX_CONNS=10

# Optional: a throwaway database for the Postgres integration test in
# `make tests`. Leave empty to skip it. It creates and deletes its own rows.
TEST_POSTGRES_DSN=

# ── Redis ─────────────────────────────────────────────────────────────────────
# Host: localhost:6379 (make deps). The devcontainer overrides it to redis:6379.
REDIS_ADDR=localhost:6379
# Host port `make deps` publishes Redis on. Change both when 6379 is taken.
REDIS_PORT=6379
REDIS_PASSWORD=

# ── Auth ──────────────────────────────────────────────────────────────────────
# At least 32 characters: openssl rand -hex 32
JWT_SECRET=
JWT_EXPIRY=15m
REFRESH_TOKEN_EXPIRY=720h
# Optional. One-time token for creating the first admin (POST /api/setup/admin),
# at least 32 characters. Empty: git2 generates one at startup and logs it.
GIT2_SETUP_TOKEN=

# ── git-svc and public address ────────────────────────────────────────────────
# Read by both git2 core (dash-api) and the gateway.
# git-svc's gRPC port (git2-codeplane): dash-api reads repositories through
# it, the gateway looks repositories up for Git routes.
GIT_SVC_GRPC_ADDR=localhost:9090
# The address users type, http(s)://<host>[:port], no path. dash-api builds
# clone URLs from it; the gateway redirects plain HTTP to it. Empty in dev
# means http://localhost:8000 (the gateway); required when ENVIRONMENT=prod.
GIT2_EXTERNAL_URL=

# ── Gateway ───────────────────────────────────────────────────────────────────
# Addresses (CIDRs or IPs, comma-separated) whose X-Real-IP header is believed.
# Set it to the gateway's network in Compose/Helm. Empty: the header is ignored.
TRUSTED_PROXY_CIDRS=

# The gateway process itself (cmd/gateway). It also reads REDIS_ADDR,
# REDIS_PASSWORD and JWT_SECRET above, which must match git2 core's, and
# POSTGRES_DSN, to check Git passwords against auth-svc's users.
GATEWAY_PORT=8000
# git2 core, where every /api route goes.
GIT2_CORE_URL=http://localhost:8080
# Holds dash/ and admin/, the built web apps (pnpm build in web/).
GATEWAY_WEB_DIR=/srv/web
# git-svc's Smart HTTP port, where the Git route streams to.
GIT_SVC_HTTP_URL=http://localhost:9080
# TLS: both files or neither. Without them the gateway serves plain HTTP.
GATEWAY_TLS_CERT_FILE=
GATEWAY_TLS_KEY_FILE=
# With TLS: a plain-HTTP port that only redirects (308) to GIT2_EXTERNAL_URL
# (above), which must then be https://<host>[:port].
GATEWAY_HTTP_REDIRECT_PORT=
